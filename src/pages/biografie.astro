---
import Seite from '../layouts/Seite.astro';
import Abschnittskopf from '../components/Abschnittskopf.astro';
import { texte, url } from '../lib/daten.js';
import { personId } from '../lib/seo.js';
const kapitel = texte.biografieKapitel || {};
const site = new URL(url(''), Astro.site);
const profil = { '@type': 'ProfilePage', name: 'Biografie Guido Mancusi', mainEntity: { '@id': personId(site) } };
---
<Seite titel="Biografie – Guido Mancusi, Komponist und Dirigent" beschreibung="Guido Mancusi, geboren 1966 in Neapel: Komponist von Operetten und Opern, Dirigent in Klagenfurt, Schönbrunn, an der Volksoper Wien, in Mörbisch und Timișoara." aktiv="biografie" bild="bilder/guido-mancusi-portraet.jpg" daten={[profil]}>
  <section class="abschnitt huelle">
    <Abschnittskopf ziffer="E" tempo="Adagio espressivo" mm="60" titel="Biografie" ebene="h1" />
    <div class="biografie">
      <div class="biografie__bilder">
        <figure class="foto"><img src={url('bilder/guido-mancusi-portraet.webp')} width="562" height="820" alt="Porträt Guido Mancusi" /></figure>
        <figure class="foto"><img src={url('bilder/guido-mancusi-geste.webp')} srcset={`${url('bilder/guido-mancusi-geste-600.webp')} 600w, ${url('bilder/guido-mancusi-geste.webp')} 900w`} sizes="(max-width: 900px) 100vw, 360px" width="900" height="1200" alt="Guido Mancusi im Frack beim Dirigieren" loading="lazy" /></figure>
        <figure class="foto"><img src={url('bilder/guido-mancusi-dirigat.webp')} width="1007" height="670" alt="Guido Mancusi beim Dirigieren" loading="lazy" /></figure>
      </div>
      <div class="textseite">
        {texte.steckbrief?.length > 0 && (
          <section class="steckbrief" aria-labelledby="steckbrief">
            <h2 id="steckbrief" class="versal steckbrief__titel">Auf einen Blick</h2>
            <dl>
              {texte.steckbrief.map((s) => <div><dt>{s.feld}</dt><dd>{s.wert}</dd></div>)}
            </dl>
          </section>
        )}
        {texte.biografie.map((a, i) => (
          <>
            {kapitel[i] && <h2 class="kapitel">{kapitel[i]}</h2>}
            <p class:list={[i === 0 && 'erster']}>{a}</p>
          </>
        ))}
        <p class="motto">„{texte.motto}“</p>
      </div>
    </div>
  </section>
</Seite>

<style>
  .biografie { display: flex; flex-wrap: wrap; gap: 48px 72px; align-items: flex-start; }
  .biografie__bilder { flex: 0 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .textseite { flex: 1 1 520px; }
  .erster::first-letter { float: left; font-family: var(--titel); font-weight: 500; font-size: 96px; line-height: .82; padding: 8px 12px 0 0; color: var(--rot); }
  .kapitel { font-family: var(--titel); font-weight: 500; font-size: clamp(26px, 3vw, 32px); line-height: 1.15; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--linie); }
  .kapitel:first-of-type { border-top: 0; padding-top: 0; margin-top: 0; }
  .motto { font-family: var(--titel); font-style: italic; font-size: 30px; line-height: 1.25; margin-top: 16px; padding-top: 22px; border-top: 3px double var(--tinte); }

  .steckbrief { background: var(--elfenbein); border: 1px solid var(--blattgold); outline: 1px solid var(--blattgold); outline-offset: -9px; padding: 28px 30px 20px; margin-bottom: 18px; }
  .steckbrief__titel { color: var(--rot); font-size: 14px; margin-bottom: 10px; }
  .steckbrief dl { margin: 0; }
  .steckbrief dl div { display: grid; grid-template-columns: minmax(0, 150px) minmax(0, 1fr); gap: 4px 20px; padding: 10px 0; border-bottom: 1px solid var(--linie); }
  .steckbrief dl div:last-child { border-bottom: 0; }
  .steckbrief dt { font-size: 13px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--tinte-2); padding-top: 3px; }
  .steckbrief dd { margin: 0; font-size: 18px; line-height: 1.5; }
  @media (max-width: 560px) { .steckbrief { padding: 22px 18px 14px; } .steckbrief dl div { grid-template-columns: 1fr; } }
</style>
