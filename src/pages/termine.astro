---
import Seite from '../layouts/Seite.astro';
import Abschnittskopf from '../components/Abschnittskopf.astro';
import TerminListe from '../components/TerminListe.astro';
import {
  kommendeTermine, vergangeneTermine, termineNachMonat, datum, wochentag, monatKurz, url,
} from '../lib/daten.js';

const kommend = kommendeTermine();
const naechster = kommend[0];
const weitere = kommend.slice(1);
const monate = termineNachMonat(weitere);
const vergangen = vergangeneTermine();
const jahre = [...new Set(vergangen.map((t) => t.von.slice(0, 4)))];
const nd = naechster ? datum(naechster.von, naechster.bis) : null;
const tagZahl = naechster ? Number(naechster.von.slice(8, 10)) : 0;
---
<Seite titel="Termine – Guido Mancusi" beschreibung="Kommende Konzerte und Opernabende mit Guido Mancusi." aktiv="termine">
  <section class="abschnitt huelle">
    <Abschnittskopf ziffer="A" tempo="Allegro con brio" mm="144" titel="Termine" ebene="h1" />

    {naechster ? (
      <article class="ticket" data-ende={naechster.bis || naechster.von}>
        <div class="ticket__haupt">
          <p class="versal ticket__oben">Nächster Auftritt <span class="ticket__countdown" data-von={naechster.von} data-bis={naechster.bis || naechster.von}></span></p>
          <p class="ticket__datum">{!naechster.bis && <span>{wochentag(naechster.von)}, </span>}{nd.lang}{naechster.zeit && <span> · {naechster.zeit} Uhr</span>}</p>
          <h2 class="ticket__titel">{naechster.titel}</h2>
          {naechster.ort && <p class="ticket__ort">{naechster.ort}</p>}
          {naechster.mit && <p class="ticket__mit">{naechster.mit}</p>}
          {naechster.programm && <p class="ticket__programm">{naechster.programm}</p>}
          <a class="knopf knopf--rot ticket__knopf" href={url(`termine/${naechster.id}.ics`)} download={`${naechster.id}.ics`}>
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2.5" y="4" width="17" height="15.5" /><path d="M2.5 8.5h17M7 2v4M15 2v4M11 11.5v5M8.5 14h5" /></svg>
            In den Kalender
          </a>
        </div>
        <div class="ticket__abriss" aria-hidden="true">
          <span class="ticket__tag">{tagZahl}</span>
          <span class="ticket__monat">{monatKurz(naechster.von)}</span>
          <span class="ticket__jahr">{naechster.von.slice(0, 4)}</span>
          <span class="ticket__fuss">Guido Mancusi<br />dirigiert</span>
        </div>
      </article>
    ) : (
      <p class="einleitung">Neue Termine folgen in Kürze.</p>
    )}

    {monate.length > 0 && (
      <div class="spielzeit">
        <p class="versal spielzeit__label">Weitere Termine</p>
        {monate.map((m) => (
          <section class="monat" aria-label={m.name} data-monat>
            <h2 class="monat__name">{m.name.split(' ')[0]} <span>{m.name.split(' ')[1]}</span></h2>
            <TerminListe termine={m.termine} kalender />
          </section>
        ))}
      </div>
    )}
  </section>

  {vergangen.length > 0 && (
    <section class="abschnitt huelle" aria-labelledby="archiv">
      <h2 id="archiv" class="archiv__titel">Vergangene Termine</h2>
      <div class="archiv">
        {jahre.map((j) => (
          <details class="jahr">
            <summary><span class="jahr__zahl">{j}</span><span class="jahr__anzahl">{vergangen.filter((t) => t.von.startsWith(j)).length} Termine</span></summary>
            <div class="jahr__inhalt">
              <TerminListe termine={vergangen.filter((t) => t.von.startsWith(j))} vergangen />
            </div>
          </details>
        ))}
      </div>
    </section>
  )}
</Seite>

<style>
  /* ---------- Eintrittskarte ---------- */
  .ticket { display: grid; grid-template-columns: minmax(0, 1fr) 220px; filter: drop-shadow(0 22px 26px rgba(43, 32, 24, .2)) drop-shadow(0 2px 3px rgba(43, 32, 24, .08)); position: relative; animation: hereingleiten .8s var(--weich) .15s both; }
  .ticket__haupt { background: var(--elfenbein); padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 8px; border: 1px solid var(--blattgold); border-right: 0; outline: 1px solid var(--blattgold); outline-offset: -9px; }
  .ticket__oben { color: var(--rot); display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; margin-bottom: 6px; }
  .ticket__countdown { font-family: var(--titel); font-style: italic; text-transform: none; letter-spacing: 0; font-size: 19px; color: var(--gold); }
  .ticket__datum { font-family: var(--titel); font-size: clamp(22px, 2.6vw, 28px); color: var(--tinte-2); }
  .ticket__titel { font-family: var(--titel); font-weight: 500; font-size: clamp(36px, 5vw, 60px); line-height: 1.04; letter-spacing: -0.015em; text-wrap: balance; }
  .ticket__ort { font-size: 22px; margin-top: 6px; }
  .ticket__mit { font-size: 19px; font-style: italic; color: var(--tinte-2); }
  .ticket__programm { font-size: 17px; color: var(--tinte-3); }
  .ticket__knopf { align-self: flex-start; margin-top: 18px; }
  .ticket__abriss { position: relative; background: var(--rot); color: var(--elfenbein); padding: 28px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; text-align: center; border-left: 2px dashed rgba(255, 252, 245, .55); background-image: radial-gradient(ellipse 120% 70% at 50% 0%, rgba(201, 164, 92, .25), transparent 70%); }
  /* echte Ausstanzungen an der Abrisskante: Halbkreise werden aus beiden Teilen herausmaskiert */
  .ticket { --loch: 14px; }
  .ticket__haupt { -webkit-mask: radial-gradient(circle var(--loch) at 100% 0, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 100% 100%, transparent 97%, #000 100%); mask: radial-gradient(circle var(--loch) at 100% 0, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 100% 100%, transparent 97%, #000 100%); -webkit-mask-composite: source-in; mask-composite: intersect; }
  .ticket__abriss { -webkit-mask: radial-gradient(circle var(--loch) at 0 0, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 0 100%, transparent 97%, #000 100%); mask: radial-gradient(circle var(--loch) at 0 0, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 0 100%, transparent 97%, #000 100%); -webkit-mask-composite: source-in; mask-composite: intersect; }
  .ticket__tag { font-family: var(--titel); font-weight: 500; font-size: 96px; line-height: .9; }
  .ticket__monat { font-size: 15px; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: var(--blattgold-hell); }
  .ticket__jahr { font-family: var(--titel); font-style: italic; font-size: 20px; }
  .ticket__fuss { margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(201, 164, 92, .6); font-size: 12px; letter-spacing: .22em; text-transform: uppercase; line-height: 1.6; color: var(--blattgold-hell); }
  @media (max-width: 640px) {
    .ticket { grid-template-columns: 1fr; }
    .ticket__haupt { border-right: 1px solid var(--blattgold); border-bottom: 0; }
    .ticket__abriss { flex-direction: row; flex-wrap: wrap; gap: 4px 12px; padding: 18px 20px; border-left: 0; border-top: 2px dashed rgba(255, 252, 245, .55); }
    .ticket__haupt { -webkit-mask: radial-gradient(circle var(--loch) at 0 100%, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 100% 100%, transparent 97%, #000 100%); mask: radial-gradient(circle var(--loch) at 0 100%, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 100% 100%, transparent 97%, #000 100%); -webkit-mask-composite: source-in; mask-composite: intersect; }
    .ticket__abriss { -webkit-mask: radial-gradient(circle var(--loch) at 0 0, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 100% 0, transparent 97%, #000 100%); mask: radial-gradient(circle var(--loch) at 0 0, transparent 97%, #000 100%), radial-gradient(circle var(--loch) at 100% 0, transparent 97%, #000 100%); -webkit-mask-composite: source-in; mask-composite: intersect; }
    .ticket__tag { font-size: 44px; }
    .ticket__fuss { display: none; }
  }

  /* ---------- Weitere Termine nach Monaten ---------- */
  .spielzeit { display: flex; flex-direction: column; gap: 8px; margin-top: 24px; }
  .spielzeit__label { color: var(--rot); }
  .monat { padding-top: 24px; display: flex; flex-direction: column; gap: 14px; }
  .monat[hidden] { display: none; }
  .monat__name { font-family: var(--titel); font-style: italic; font-weight: 400; font-size: clamp(34px, 4.4vw, 48px); line-height: 1; color: var(--tinte); }
  .monat__name span { font-style: normal; font-size: .5em; color: var(--gold); letter-spacing: .08em; vertical-align: .35em; }

  /* ---------- Archiv (zugeklappt) ---------- */
  .archiv__titel { font-family: var(--titel); font-weight: 500; font-size: clamp(30px, 3.8vw, 40px); }
  .archiv { display: flex; flex-direction: column; border-top: 1.5px solid var(--tinte); }
  .jahr { border-bottom: 1px solid var(--linie); }
  .jahr summary { list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: 16px; padding: 20px 0; min-height: 44px; }
  .jahr summary::-webkit-details-marker { display: none; }
  .jahr__zahl { font-family: var(--titel); font-weight: 500; font-size: 32px; transition: color .35s var(--weich); }
  .jahr summary:hover .jahr__zahl { color: var(--rot); }
  .jahr summary::after { content: ''; width: 11px; height: 11px; border-right: 1.5px solid var(--tinte); border-bottom: 1.5px solid var(--tinte); transform: rotate(45deg); transition: transform .45s var(--weich); align-self: center; }
  .jahr[open] summary::after { transform: rotate(-135deg); }
  .jahr__anzahl { margin-left: auto; font-style: italic; color: var(--tinte-2); }
  .jahr__inhalt { padding-bottom: 28px; }
  .jahr__inhalt :global(.liste) { border-top-width: 1px; border-top-color: var(--linie); }
  .jahr__inhalt :global(.zeile__gross) { color: var(--tinte-3); font-size: 40px; }
  @supports (interpolate-size: allow-keywords) {
    .jahr { interpolate-size: allow-keywords; }
    .jahr::details-content { block-size: 0; overflow: hidden; transition: block-size .55s var(--weich), content-visibility .55s allow-discrete; }
    .jahr[open]::details-content { block-size: auto; }
  }
</style>

<script>
  // Countdown bis zum nächsten Auftritt (Wiener Zeit)
  const heute = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Vienna' }).format(new Date());
  const tageBis = (iso) => Math.round((Date.parse(iso + 'T00:00:00Z') - Date.parse(heute + 'T00:00:00Z')) / 86400000);
  document.querySelectorAll('.ticket__countdown').forEach((el) => {
    const n = tageBis(el.dataset.von);
    const laeuft = el.dataset.von <= heute && el.dataset.bis >= heute;
    el.textContent = laeuft ? '· läuft gerade' : n === 1 ? '· morgen' : n === 0 ? '· heute' : n > 1 ? `· in ${n} Tagen` : '';
  });

  // Monate ohne sichtbare Termine ausblenden (falls seit dem Build etwas vorbei ist)
  document.querySelectorAll('[data-monat]').forEach((m) => {
    m.hidden = !m.querySelector('.zeile[data-ende]:not([hidden])');
  });

</script>
